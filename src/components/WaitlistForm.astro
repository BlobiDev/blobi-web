---
import en from '../i18n/en.json';
import es from '../i18n/es.json';
import { waitlistConfig } from '../lib/waitlist.mjs';
interface Props { lang: 'en' | 'es'; id: string; }
const { lang, id } = Astro.props as Props;
const t = (lang === 'es' ? es : en).waitlist;
const config = waitlistConfig(import.meta.env);
// Listmonk redirects here after a submission when this exact URL is in its trusted URLs.
const next = new URL(lang === 'es' ? '/es/gracias/' : '/thanks/', Astro.site).href;
---
<form class="waitlist" method="post" action={config?.endpoint} aria-describedby={`${id}-note`}>
  {config && <>
    <input type="hidden" name="l" value={config.lists[lang]}/>
    <input type="hidden" name="next" value={next}/>
    <div class="waitlist-trap" aria-hidden="true"><label>{t.trap}<input type="text" name="nonce" value="" tabindex="-1" autocomplete="off"/></label></div>
  </>}
  <div class="waitlist-row">
    <label class="visually-hidden" for={`${id}-email`}>{t.label}</label>
    <input id={`${id}-email`} name="email" type="email" required autocomplete="email" inputmode="email" placeholder={t.placeholder} disabled={!config}/>
    <button type="submit" disabled={!config}>{t.button}</button>
  </div>
  {config && <label class="waitlist-consent"><input type="checkbox" required/><span>{t.consent}</span></label>}
  <p class="waitlist-note" id={`${id}-note`}>{config ? t.note : t.closed}</p>
</form>
<style>
.waitlist{display:grid;gap:10px;max-width:480px}
.waitlist-row{display:flex;gap:8px;padding:5px;border:1px solid var(--line-strong);border-radius:14px;background:var(--bg);box-shadow:0 1px 2px rgb(12 26 48/.05);transition:border-color .2s,box-shadow .2s}
.waitlist-row:focus-within{border-color:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
.waitlist-row input{flex:1;min-width:0;min-height:44px;padding:0 12px;border:0;outline:0!important;background:transparent;color:var(--ink);font-size:16px}
.waitlist-row input::placeholder{color:var(--ink-3)}
.waitlist-row button{flex:none;min-height:44px;padding:0 18px;border:0;border-radius:10px;background:var(--accent);color:#fff;font-weight:700;font-size:15px;transition:background .2s}
.waitlist-row button:hover{background:var(--accent-hover)}
.waitlist-row:has(:disabled){background:var(--bg-soft);border-style:dashed;box-shadow:none}
.waitlist-row button:disabled{background:var(--line-strong);color:var(--ink-2);cursor:not-allowed}
.waitlist-consent{display:flex;gap:9px;align-items:flex-start;color:var(--ink-2);font-size:14px;line-height:1.45}
.waitlist-consent input{width:18px;height:18px;margin:1px 0 0;accent-color:var(--accent)}
.waitlist-trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
.waitlist-note{margin:0;color:var(--ink-3);font-size:14px;line-height:1.45}
@media(max-width:420px){.waitlist-row{flex-direction:column}.waitlist-row button{width:100%}}
</style>
