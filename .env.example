# Build-time settings (all public, none secret). Copy to .env or export them before `pnpm build`.
# Empty values build the feature disabled, with no outgoing request.
PUBLIC_WAITLIST_ENDPOINT=
PUBLIC_WAITLIST_LIST_EN=
PUBLIC_WAITLIST_LIST_ES=
# https origin of the invitation service (blobi-invites), e.g. https://api.example.org; http://localhost:PORT allowed for development.
PUBLIC_INVITES_API=
